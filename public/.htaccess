# --- NORMALIZACIÓN SEO ---
RewriteEngine On

# 1. Redirigir www a NO-www (Redirección 301 permanente)
RewriteCond %{HTTP_HOST} ^www\.tamimaquinarias\.com [NC]
RewriteRule ^(.*)$ https://tamimaquinarias.com/$1 [L,R=301]

# 2. Redirecciones 301 — Rutas legacy / productos antiguos
RewriteRule ^sobre-nosotros/?$ /nosotros/ [L,R=301]
RewriteRule ^productos/?$ /catalogo-maquinarias/ [L,R=301]
RewriteRule ^productos/soldadora-spark-mig-250/?$ /catalogo-maquinarias/detalle/?link=soldadora-spark-mig-250 [L,R=301,QSA]
RewriteRule ^productos/maquina-de-embalaje-de-te/?$ /catalogo-maquinarias/detalle/?link=maquina-de-embalaje-de-te [L,R=301,QSA]
RewriteRule ^productos/soldadora-lingba/?$ /catalogo-maquinarias/detalle/?link=soldadora-lingba [L,R=301,QSA]
RewriteRule ^productos/(.+)/?$ /catalogo-maquinarias/detalle/?link=$1 [L,R=301,QSA]

# 3. Forzar slash final (Trailing Slash) en todas las URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ https://tamimaquinarias.com/$1/ [L,R=301]

# --- Habilitar rewrite para Astro ---
RewriteBase /

# 4. ErrorDocument 404
ErrorDocument 404 /404.html