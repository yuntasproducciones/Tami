---
import Layout from "src/layouts/Layout.astro";
import ProductPage from "src/components/products/ProductPage";
---

<Layout
  title="Detalle de Producto - Tami Maquinarias"
  description="Cargando detalles de producto..."
  keywords=""
  canonicalUrl="https://tamimaquinarias.com/catalogo-maquinarias/detalle/"
>
  <ProductPage client:load />
</Layout>

<script is:inline>
  (function () {
    var canonicalLink = document.querySelector('link[rel="canonical"]');
    if (canonicalLink) {
      canonicalLink.href = window.location.href.split('#')[0];
    }
  })();
</script>